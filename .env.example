# Copie para .env e ajuste os valores. .env nunca é versionado (ver .gitignore).

# --- Ambiente ---
# "producao" (padrão se omitido) RECUSA subir com as chaves de exemplo abaixo.
# Em produção troque SECRET_KEY e PSEUDONIMO_KEY e remova/ajuste esta linha.
AMBIENTE=desenvolvimento

# --- Postgres (serviço "db" em infra/compose.yml) ---
POSTGRES_USER=docencia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=docencia

# String de conexão usada pela API. O host é sempre o nome do serviço no
# Compose ("db") — nunca "localhost", já que api e db rodam em containers
# distintos na mesma rede do compose.
DATABASE_URL=postgresql+psycopg://docencia:changeme@db:5432/docencia

# --- Autenticação ---
# Gere um valor forte em produção: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me-in-production-32b

# --- LGPD ---
# Chave do HMAC que pseudonimiza o ator do log de auditoria. Separada
# do SECRET_KEY. Não troque depois de ter log gravado: os pseudônimos antigos
# deixam de ser comparáveis com os novos. Gere com:
# python -c "import secrets; print(secrets.token_hex(32))"
PSEUDONIMO_KEY=dev-pseudonimo-key-change-me-in-production

# --- Primeiro administrador ---
# Lidos só pela migração que semeia a conta (alembic upgrade head). Com os três
# definidos, ela cria o administrador — ou promove a conta, se a credencial já
# existir, sem trocar a senha. Sem eles, nenhum administrador é criado. Senha de
# 8 a 72 caracteres. Depois de migrar, pode apagar ADMIN_SENHA daqui.
ADMIN_CREDENCIAL=admin
ADMIN_NOME=Administrador
ADMIN_SENHA=troque-esta-senha

# --- Materiais ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=30
OCR_ENABLED=true
OCR_LANGS=por+eng
OCR_DPI=300
OCR_CONFIANCA_MINIMA=60
OCR_MAX_PAGINAS=150
# Tetos de recurso: MAX_UPLOAD_MB só limita o arquivo comprimido.
MAX_PDF_PAGINAS=1000
OCR_MAX_MEGAPIXELS=40
MAX_OOXML_DESCOMPRIMIDO_MB=200
MAX_OOXML_ENTRADAS=10000
MIN_CHARS_PAGINA=25
LIMIAR_PAGINAS_LEGIVEIS=0.8
# Caminho do binário tesseract quando não está no PATH.
TESSERACT_CMD=/usr/bin/tesseract

# --- RAG ---
# Ollama roda no host. Dentro do Compose use http://host.docker.internal:11434
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=dengcao/Qwen3-Embedding-0.6B:Q8_0
EMBEDDING_BATCH=64
EMBEDDING_TIMEOUT_S=120
RERANK_BASE_URL=http://localhost:11434
RERANK_MODEL=qwen3:1.7b
RERANK_TIMEOUT_S=120
RAG_CANDIDATOS=20
RAG_TOP_K=8
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=200
CHUNK_MIN_CHARS=300

# --- Provider Adapter ---
# Usado quando provedores_llm.endpoint é NULL.
LLM_BASE_URL=http://localhost:11434
# Não baixar sem medir: o Ollama trunca o prompt em silêncio para caber aqui.
LLM_NUM_CTX=8192
LLM_TIMEOUT_S=180
LLM_TENTATIVAS_POR_PROVEDOR=2
# Rotas de LLM simultâneas por processo; acima disso, 503 imediato.
LLM_MAX_CONCORRENTES=4
LLM_TEMPERATURA_PADRAO=0.3
LLM_MAX_TOKENS_PADRAO=2048

# --- Geração ---
# Acima do LLM_TEMPERATURA_PADRAO: repetição entre itens é o risco maior.
GERACAO_TEMPERATURA=0.4
GERACAO_MAX_TOKENS=2048
CRITICO_TEMPERATURA=0.1
CRITICO_MAX_TOKENS=2048

# --- Auditoria ---
# O mínimo da cadeia, igual ao do crítico.
AUDITORIA_TEMPERATURA=0.1
AUDITORIA_MAX_TOKENS=2048

# Copie para .env e ajuste os valores. .env nunca é versionado (ver .gitignore).

# --- Postgres (serviço "db" em infra/compose.yml) ---
POSTGRES_USER=docencia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=docencia

# String de conexão usada pela API. O host é sempre o nome do serviço no
# Compose ("db") — nunca "localhost", já que api e db rodam em containers
# distintos na mesma rede do compose.
DATABASE_URL=postgresql+psycopg://docencia:changeme@db:5432/docencia

# --- Autenticação ---
# Gere um valor forte em produção: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me-in-production-32b
